---
import Layout from '../../layouts/Layout.astro';
import AssetForm from '../../components/AssetForm.astro';
import AssetThumb from '../../components/AssetThumb.astro';
import DepreciationSignal from '../../components/DepreciationSignal.astro';
import { deleteAsset, getAssetById, updateAsset } from '../../services/assets';
import { calcAssetDepreciation } from '../../services/depreciation';
import {
  parseOptionalInt,
  formatCurrency,
  formatDateTime,
  formatSignedCurrency,
} from '../../utils/formatters';
import { CONDITION_LABELS, type AssetCondition } from '../../types/asset';

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/assets');
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const method = String(form.get('_method') ?? 'PUT').toUpperCase();

  if (method === 'DELETE') {
    await deleteAsset(id);
    return Astro.redirect('/assets');
  }

  await updateAsset(id, {
    name: String(form.get('name') ?? '').trim(),
    category: String(form.get('category') ?? '').trim(),
    brand: String(form.get('brand') ?? '').trim() || null,
    purchase_price: parseOptionalInt(String(form.get('purchase_price') ?? '')),
    purchase_date: String(form.get('purchase_date') ?? '').trim() || null,
    market_price: parseOptionalInt(String(form.get('market_price') ?? '')),
    condition: (String(form.get('condition') ?? 'good') as AssetCondition) || 'good',
    notes: String(form.get('notes') ?? '').trim() || null,
    image_url: String(form.get('image_url') ?? '').trim() || null,
  });

  return Astro.redirect(`/assets/${id}`);
}

const asset = await getAssetById(id);
if (!asset) {
  return Astro.redirect('/assets');
}

const depreciation = calcAssetDepreciation(asset);
---

<Layout title={asset.name}>
  <section class="flex flex-col items-center text-center">
    <AssetThumb asset={asset} size="md" />
    <p class="mt-4 font-display text-xs font-bold tracking-wide text-accent">
      {asset.category}
    </p>
    <h1 class="mt-2 font-display text-3xl font-bold sm:text-4xl">{asset.name}</h1>
    {
      asset.brand && (
        <p class="mt-2 text-ink-muted">{asset.brand}</p>
      )
    }
    <div class="mt-4 flex justify-center">
      <DepreciationSignal
        signal={depreciation.signal}
        vsBook={depreciation.vsBook}
      />
    </div>
  </section>

  <dl class="mt-8 grid grid-cols-2 gap-3 text-center text-sm sm:grid-cols-3">
    <div class="pixel-panel rounded-lg bg-white p-4">
      <dt class="text-ink-muted">購入価格</dt>
      <dd class="mt-1 text-lg font-bold tabular-nums">
        {formatCurrency(asset.purchase_price)}
      </dd>
    </div>
    <div class="pixel-panel rounded-lg bg-white p-4">
      <dt class="text-ink-muted">減価償却後簿価</dt>
      <dd class="mt-1 text-lg font-bold tabular-nums">
        {formatCurrency(depreciation.bookValue)}
      </dd>
    </div>
    <div class="pixel-panel-accent rounded-lg bg-accent-soft p-4">
      <dt class="text-ink-muted">推定相場</dt>
      <dd class="mt-1 text-lg font-bold tabular-nums text-accent">
        {formatCurrency(asset.market_price)}
      </dd>
    </div>
    <div class="pixel-panel rounded-lg bg-white p-4">
      <dt class="text-ink-muted">対簿価</dt>
      <dd
        class:list={[
          'mt-1 text-lg font-bold tabular-nums',
          depreciation.signal === 'plus'
            ? 'text-accent'
            : depreciation.signal === 'minus'
              ? 'text-ink'
              : 'text-ink-muted',
        ]}
      >
        {formatSignedCurrency(depreciation.vsBook)}
      </dd>
    </div>
    <div class="pixel-panel rounded-lg bg-white p-4">
      <dt class="text-ink-muted">経過 / 耐用</dt>
      <dd class="mt-1 text-lg font-bold">
        {depreciation.ageLabel}
        <span class="text-sm font-medium text-ink-muted">
          / {depreciation.usefulLifeYears}年
        </span>
      </dd>
    </div>
    <div class="pixel-panel rounded-lg bg-white p-4">
      <dt class="text-ink-muted">状態</dt>
      <dd class="mt-1 text-lg font-bold">
        {CONDITION_LABELS[asset.condition]}
      </dd>
    </div>
  </dl>

  <div class="mt-4">
    <div class="h-2 w-full bg-ink/10">
      <div
        class="h-full bg-accent"
        style={`width: ${Math.round(depreciation.progress * 100)}%`}
      ></div>
    </div>
    <p class="mt-2 text-center text-xs text-ink-muted">
      償却進度 {Math.round(depreciation.progress * 100)}% · 相場更新:
      {formatDateTime(asset.market_price_updated_at)}
    </p>
  </div>

  <section class="mt-12">
    <h2 class="text-center font-display text-2xl font-bold">編集</h2>
    <div class="mt-4">
      <AssetForm asset={asset} action={`/assets/${asset.id}`} method="PUT" />
    </div>

    <form method="POST" action={`/assets/${asset.id}`} class="mt-6 text-center">
      <input type="hidden" name="_method" value="DELETE" />
      <button
        type="submit"
        class="btn-beep rounded-md border-[color:var(--color-danger)] bg-white px-4 py-2 text-sm font-bold text-[color:var(--color-danger)] hover:bg-accent-soft"
        onclick="return confirm('この資産を削除しますか？');"
      >
        資産を削除
      </button>
    </form>
  </section>
</Layout>
