---
import Layout from '../../layouts/Layout.astro';
import AssetCard from '../../components/AssetCard.astro';
import { listAssets } from '../../services/assets';
import { ASSET_CATEGORIES } from '../../types/asset';

const assets = await listAssets();
const selectedCategory = Astro.url.searchParams.get('category') ?? 'all';
const filtered =
  selectedCategory === 'all'
    ? assets
    : assets.filter((asset) => asset.category === selectedCategory);
---

<Layout title="資産一覧">
  <section class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="font-display text-3xl font-bold">資産一覧</h1>
      <p class="mt-1 text-sm text-ink-muted">
        {filtered.length} / {assets.length} 件を表示
      </p>
    </div>
    <a
      href="/assets/new"
      class="inline-flex rounded-md bg-accent px-4 py-2.5 text-sm font-semibold text-white transition hover:brightness-110"
    >
      新規登録
    </a>
  </section>

  <form method="GET" class="mt-6 flex flex-wrap items-center gap-2">
    <label class="text-sm text-ink-muted" for="category">カテゴリ</label>
    <select
      id="category"
      name="category"
      class="rounded-md border border-line bg-surface-elevated px-3 py-2 text-sm outline-none ring-accent/30 focus:ring-2"
      onchange="this.form.submit()"
    >
      <option value="all" selected={selectedCategory === 'all'}>すべて</option>
      {
        ASSET_CATEGORIES.map((category) => (
          <option value={category} selected={selectedCategory === category}>
            {category}
          </option>
        ))
      }
    </select>
  </form>

  {
    filtered.length === 0 ? (
      <p class="mt-8 rounded-xl border border-dashed border-line bg-surface-elevated px-5 py-12 text-center text-ink-muted">
        該当する資産がありません。
      </p>
    ) : (
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {filtered.map((asset) => (
          <AssetCard asset={asset} />
        ))}
      </div>
    )
  }
</Layout>
