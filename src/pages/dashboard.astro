---
import Layout from '../layouts/Layout.astro';
import TrendChart from '../components/charts/TrendChart.astro';
import CategoryBars from '../components/charts/CategoryBars.astro';
import AssetCard from '../components/AssetCard.astro';
import { buildCategoryShares, buildMonthlyTrend } from '../services/analytics';
import { buildDashboardStats, listAssets } from '../services/assets';
import { buildDepreciationSummary } from '../services/depreciation';
import { formatCurrency, formatSignedCurrency } from '../utils/formatters';

const assets = await listAssets();
const stats = buildDashboardStats(assets);
const trend = buildMonthlyTrend(assets, 12);
const categoryShares = buildCategoryShares(assets);
const depreciation = buildDepreciationSummary(assets);
const recentAssets = assets.slice(0, 5);

const signalTone =
  depreciation.signal === 'plus'
    ? 'text-accent'
    : depreciation.signal === 'minus'
      ? 'text-ink'
      : 'text-ink-muted';
---

<Layout title="ダッシュボード">
  <section class="grid gap-8 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:items-stretch lg:gap-10">
    <!-- 左: 金額は上にまとめ、注記は下端へ -->
    <div class="flex h-full flex-col text-center lg:border-r lg:border-ink/15 lg:pr-10 lg:text-left">
      <div>
        <p class="text-xs font-bold tracking-[0.18em] text-accent">DASHBOARD</p>
        <h1 class="mt-1 font-display text-2xl font-bold">資産サマリー</h1>
        <p class="mt-1 text-sm text-ink-muted lg:max-w-[18rem]">
          相場と簿価の差分をひと目で確認
        </p>

        <p class="mt-6 font-display text-5xl font-black tabular-nums tracking-tight text-accent sm:text-6xl">
          {formatCurrency(stats.totalMarketValue)}
        </p>
        <p class="mt-1 text-sm text-ink-muted">
          推定相場合計 · {stats.totalAssets} 点
        </p>

        <dl class="mx-auto mt-4 max-w-xs space-y-1.5 text-sm lg:mx-0">
          <div class="flex items-baseline justify-between gap-4 border-b border-ink/15 py-1.5">
            <dt class="text-ink-muted">簿価</dt>
            <dd class="font-bold tabular-nums">{formatCurrency(depreciation.totalBookValue)}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 border-b border-ink/15 py-1.5">
            <dt class="text-ink-muted">相場</dt>
            <dd class="font-bold tabular-nums text-accent">
              {formatCurrency(depreciation.totalMarketValue)}
            </dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-1.5">
            <dt class="text-ink-muted">対簿価</dt>
            <dd class:list={['font-bold tabular-nums', signalTone]}>
              {formatSignedCurrency(depreciation.vsBook)}
            </dd>
          </div>
        </dl>
      </div>

      <div class="mt-6 border-t border-ink/10 pt-3 lg:mt-auto lg:pt-4">
        <p class="mx-auto max-w-xs text-xs leading-snug text-ink-muted lg:mx-0">
          定額法・残存10%の目安（税務計算ではありません）
        </p>
      </div>
    </div>

    <!-- 右: グラフ2段（上下余白を詰めて圧縮） -->
    <div class="flex min-w-0 flex-col gap-4">
      <TrendChart points={trend} />
      <div class="border-t border-ink/15 pt-4">
        <CategoryBars shares={categoryShares} />
      </div>
    </div>
  </section>

  <section class="mt-16">
    <h2 class="border-b border-ink/20 pb-3 text-center font-display text-2xl font-bold lg:text-left">
      最近の登録
    </h2>

    {
      recentAssets.length === 0 ? (
        <p class="py-10 text-center text-sm text-ink-muted lg:text-left">
          まだ資産がありません。まずは1件登録してみましょう。
        </p>
      ) : (
        <ul class="mt-4 flex flex-col gap-3">
          {recentAssets.map((asset) => (
            <li>
              <AssetCard asset={asset} />
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>
