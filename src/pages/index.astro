---
import Layout from '../layouts/Layout.astro';
import BrandMark from '../components/BrandMark.astro';
---

<Layout title="MerValue" shell="top">
  <section class="flex w-full flex-col items-center justify-center text-center">
    <div class="animate-brand-pop">
      <BrandMark size="lg" />
    </div>

    <h1 class="animate-fade-up mt-6 font-display text-6xl font-black tracking-tight sm:text-7xl">
      Mer<span class="text-accent">Value</span>
    </h1>

    <p
      class="animate-fade-up mt-4 max-w-md font-display text-lg font-bold leading-relaxed text-ink sm:text-xl"
      style="animation-delay: 80ms"
    >
      家の中のモノ、いまいくら？
    </p>

    <p
      class="animate-fade-up mt-3 max-w-sm text-sm leading-relaxed text-ink-muted"
      style="animation-delay: 140ms"
    >
      自宅の資産を見える化します。
    </p>

    <div
      class="animate-fade-up mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center"
      style="animation-delay: 200ms"
    >
      <a
        href="/dashboard"
        class="btn-beep btn-beep-accent min-w-[12rem] rounded-md px-5 py-2.5 text-sm font-bold"
      >
        ダッシュボードへ
      </a>
      <a
        href="/assets"
        class="btn-beep min-w-[12rem] rounded-md bg-white px-5 py-2.5 text-sm font-bold"
      >
        資産一覧を見る
      </a>
    </div>
  </section>
</Layout>
