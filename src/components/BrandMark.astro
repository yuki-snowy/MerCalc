---
interface Props {
  size?: 'sm' | 'md' | 'lg';
}

const { size = 'md' } = Astro.props;
const box =
  size === 'lg' ? 'h-16 w-16 p-1.5 gap-1' : size === 'sm' ? 'h-8 w-8 p-0.5 gap-0.5' : 'h-11 w-11 p-1 gap-0.5';
const dot = size === 'lg' ? 'h-3 w-3' : size === 'sm' ? 'chip-dot' : 'h-2.5 w-2.5';
---

<span
  class:list={[
    'grid shrink-0 grid-cols-2 grid-rows-2 overflow-hidden border-2 border-ink bg-white shadow-[2px_2px_0_rgba(218,62,80,0.35)]',
    box,
  ]}
  aria-hidden="true"
>
  <span class:list={[dot, 'bg-accent']}></span>
  <span class:list={[dot, 'bg-ink']}></span>
  <span class:list={[dot, 'bg-ink/25']}></span>
  <span class:list={[dot, 'bg-accent/70']}></span>
</span>
