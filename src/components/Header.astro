---
import BrandMark from './BrandMark.astro';
import { APP_NAV_LINKS, isAppNavActive } from '../utils/nav';

const pathname = Astro.url.pathname;
---

<header
  class="site-header sticky top-0 z-50 border-b border-ink/10 backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-3 sm:px-6"
  >
    <a href="/" class="inline-flex shrink-0 items-center gap-2 no-underline">
      <BrandMark size="sm" />
      <span class="font-display text-xl font-black tracking-tight">
        Mer<span class="text-accent">Calc</span>
      </span>
    </a>

    <nav
      aria-label="メインナビ"
      class="hidden flex-wrap items-center justify-end gap-2 sm:flex"
    >
      {
        APP_NAV_LINKS.map((link) => {
          const active = isAppNavActive(link.href, pathname);
          return (
            <a
              href={link.href}
              class:list={[
                'btn-beep rounded-md px-3 py-1.5 text-sm font-medium',
                active
                  ? 'btn-beep-accent'
                  : 'bg-white/80 text-ink-muted hover:text-ink',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
