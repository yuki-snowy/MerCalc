---
import BrandMark from './BrandMark.astro';

const pathname = Astro.url.pathname;

const links = [
  { href: '/dashboard', label: 'ダッシュボード' },
  { href: '/assets', label: '資産一覧' },
  { href: '/assets/new', label: '新規登録' },
];
---

<header
  class="site-header sticky top-0 z-50 border-b border-ink/10 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6">
    <a href="/" class="inline-flex shrink-0 items-center gap-2 no-underline">
      <BrandMark size="sm" />
      <span class="font-display text-xl font-black tracking-tight">
        Mer<span class="text-accent">Calc</span>
      </span>
    </a>

    <nav aria-label="メインナビ" class="flex flex-wrap items-center justify-end gap-2">
      {
        links.map((link) => {
          const active =
            link.href === '/dashboard'
              ? pathname === '/dashboard'
              : link.href === '/assets'
                ? pathname === '/assets' ||
                  (pathname.startsWith('/assets/') && pathname !== '/assets/new')
                : pathname === link.href;
          return (
            <a
              href={link.href}
              class:list={[
                'btn-beep rounded-md px-3 py-1.5 text-sm font-medium',
                active
                  ? 'btn-beep-accent'
                  : 'bg-white/80 text-ink-muted hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
