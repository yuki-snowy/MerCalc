---
import BrandMark from './BrandMark.astro';

const pathname = Astro.url.pathname;

const links = [
  { href: '/', label: 'TOP' },
  { href: '/dashboard', label: 'ダッシュボード' },
  { href: '/assets', label: '資産一覧' },
  { href: '/assets/new', label: '新規登録' },
];
---

<header class="flex flex-wrap items-center justify-between gap-3">
  <a href="/" class="inline-flex shrink-0 items-center gap-2 no-underline">
    <BrandMark size="sm" />
    <span class="font-display text-xl font-black tracking-tight">
      Mer<span class="text-accent">Calc</span>
    </span>
  </a>

  <nav aria-label="メインナビ" class="flex flex-wrap items-center justify-end gap-2">
    {
      links.map((link) => {
        const active =
          link.href === '/'
            ? pathname === '/'
            : link.href === '/dashboard'
              ? pathname === '/dashboard'
              : link.href === '/assets'
                ? pathname === '/assets' ||
                  (pathname.startsWith('/assets/') && pathname !== '/assets/new')
                : pathname === link.href;
        return (
          <a
            href={link.href}
            class:list={[
              'btn-beep rounded-md px-3 py-1.5 text-sm font-medium',
              active
                ? 'btn-beep-accent'
                : 'bg-white text-ink-muted hover:text-ink',
            ]}
          >
            {link.label}
          </a>
        );
      })
    }
  </nav>
</header>
